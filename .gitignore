# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project data spreadsheets — source xlsx are large binaries; keep the dir, ignore contents
/data/*
!/data/.keep

# the working seed holds real student/teacher names and is NEVER committed.
# seed-2026.example.json (a tiny anonymised placeholder) is the only one in git;
# scripts/ensure-seed.mjs copies it into place on a fresh checkout, and
# `make seed` overwrites the copy with real data locally.
/src/data/seed-2026.json
/coverage

# python (xlsx parsing)
/.venv
__pycache__/
*.pyc
