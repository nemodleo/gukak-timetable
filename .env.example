# --- Supabase (필수) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...          # Project Settings → API → anon public
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # Project Settings → API → service_role (서버 전용, 절대 공개 금지)

# --- 로그인 (권한별 비밀번호) ---
ADMIN_PASSWORD=change-me-admin            # 관리자: 배정 + 강의실/시간블록 구조 + 회색 지정 + 명단/설정/데이터
INSTRUCTOR_PASSWORD=change-me-teacher     # 강사: 배정·직접입력·비수업(회색)·메모만. 구조 변경 불가
ADMIN_SESSION_SECRET=random-long-string   # 세션 쿠키 서명용 (아무 긴 랜덤 문자열)
# 학생: 로그인 없이 읽기 전용
