# 환경 값. 로컬은 이 파일을 .env.local로 복사해 채운다(git 제외). Vercel은 `make env-push`.
# 키마다 "비우면 어떻게 되는지"를 적었다.

# --- Supabase ---
# 셋 다 비우면 데모 모드: src/data/seed-2026.json을 읽기 전용으로 보여 주고 저장은 안 된다(로그인 잠금은 메모리로).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...          # Project Settings → API → anon public. service_role이 있으면 안 써도 됨
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # Project Settings → API → service_role (서버 전용, 절대 공개 금지). 비우면 anon으로 읽기만 — RLS 때문에 쓰기가 전부 실패

# --- 로그인 (권한별 공용 비밀번호) ---
# 셋 다 비우면 로그인 API가 503이고, 시간표는 로그인 카드만 보인다(학생 이름이 있어 비로그인 열람은 막는다).
# 하나만 비우면 그 역할로만 못 들어온다.
ADMIN_PASSWORD=change-me-admin            # 관리자: 배정 + 강의실/시간블록 구조 + 회색 지정 + 명단/설정/데이터
INSTRUCTOR_PASSWORD=change-me-teacher     # 강사: 배정·직접입력·비수업(회색)·메모만. 구조 변경 불가
VIEWER_PASSWORD=change-me-viewer          # 열람(학생·학부모): 읽기 전용
ADMIN_SESSION_SECRET=random-long-string   # 세션 쿠키 서명용 긴 랜덤 문자열. 비우면 ADMIN_PASSWORD로 서명하고, 그것도 없으면 개발용 고정 문자열 — 운영에서는 반드시 채운다
# 로그인 실패는 IP별로 5회째부터 5분→10→20→40→60분 잠금 (login_attempts 표, 없으면 인스턴스 메모리)
